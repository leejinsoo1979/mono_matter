# Optional: copy to .env. Keep real keys out of source control.
PORT=4388
APP_URL=http://127.0.0.1:5188
BETTER_AUTH_URL=http://127.0.0.1:5188
# If empty, a cryptographically random local secret is persisted in the private SQLite database.
BETTER_AUTH_SECRET=
DATA_DIR=runtime
ALLOW_LOCAL_VISITOR=true
CREDITS_TIME_ZONE=Asia/Seoul
# Comma-separated exact origins; never use * for authenticated requests.
TRUSTED_ORIGINS=

# Google callback: APP_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pinterest app credentials. Only read scopes are requested; tokens stay encrypted on the server.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Register this exact callback URI with Pinterest (defaults to APP_URL + the path below).
PINTEREST_REDIRECT_URI=http://127.0.0.1:5188/api/integrations/pinterest/callback

# JSON image-generation gateway. POST accepts model,prompt,n,size and optional image data URL.
# Response: {data:[{url:"https://..."}]} or {data:[{b64_json:"..."}]} or {url:"https://..."}.
AI_RENDER_ENDPOINT=
AI_API_KEY=
AI_MODEL=
AI_CREDITS_PER_RENDER=10

# Optional Resend-compatible HTTP mail gateway. No configuration means internal intake only.
# Recipient routing is configured by the operator; arbitrary caller-supplied recipients are never used.
MAIL_SEND_ENDPOINT=
MAIL_API_KEY=
MAIL_FROM=
REQUESTS_TO=

# Real Stripe checkout. Entitlements activate only after a verified webhook, never after a redirect.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-03-31.basil
# Send checkout.session.completed, checkout.session.async_payment_succeeded, invoice.paid,
# customer.subscription.created/updated/deleted/paused/resumed to /api/billing/webhook.
# The server verifies live subscription status and configured price IDs before granting paid access.
# Plus renews to 2,500 credits per calendar month, including annually billed subscriptions.
# Credits expire when paid access ends. They do not accumulate or reset on duplicate invoices.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
